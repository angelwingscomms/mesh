{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mesh",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [{ "binding": "DB", "database_name": "mesh", "database_id": "local", "migrations_dir": "migrations" }],
	"r2_buckets": [{ "binding": "R2", "bucket_name": "mesh" }],
	"workers_dev": true,
	"preview_urls": true
}
